<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Muhammad Fachry Yusfi | Portfolio</title>

    <!-- Google Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <style>
        /* =========================================================
           RESET
        ========================================================= */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        :root {
            --bg: #06111f;
            --bg-secondary: #0a192d;
            --card: rgba(13, 31, 52, 0.75);
            --card-border: rgba(0, 212, 255, 0.15);
            --primary: #00d9ff;
            --primary-dark: #008cff;
            --text: #ffffff;
            --text-light: #b8c7d9;
            --text-muted: #8293a8;
            --gradient: linear-gradient(135deg, #00d9ff, #007bff, #6c2cff);
            --shadow: 0 15px 45px rgba(0, 0, 0, 0.35);
        }

        body {
            font-family: 'Poppins', sans-serif;
            background:
                radial-gradient(circle at 10% 20%, rgba(0, 217, 255, 0.08), transparent 30%),
                radial-gradient(circle at 90% 80%, rgba(108, 44, 255, 0.1), transparent 30%),
                var(--bg);
            color: var(--text);
            line-height: 1.7;
            overflow-x: hidden;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        img {
            max-width: 100%;
            display: block;
        }

        ul {
            list-style: none;
        }

        .container {
            width: 90%;
            max-width: 1200px;
            margin: auto;
        }

        section {
            padding: 100px 0;
        }

        /* =========================================================
           SCROLLBAR
        ========================================================= */
        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-track {
            background: #06111f;
        }

        ::-webkit-scrollbar-thumb {
            background: var(--gradient);
            border-radius: 10px;
        }

        /* =========================================================
           NAVBAR
        ========================================================= */
        header {
            position: fixed;
            width: 100%;
            top: 0;
            left: 0;
            z-index: 999;
            background: rgba(6, 17, 31, 0.85);
            backdrop-filter: blur(15px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        }

        .navbar {
            height: 80px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .logo {
            width: 48px;
            height: 48px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            font-weight: 800;
            background: var(--gradient);
            box-shadow: 0 8px 25px rgba(0, 150, 255, 0.25);
        }

        .nav-links {
            display: flex;
            gap: 30px;
            align-items: center;
        }

        .nav-links a {
            color: var(--text-light);
            font-size: 14px;
            font-weight: 500;
            transition: 0.3s;
            position: relative;
        }

        .nav-links a::after {
            content: "";
            position: absolute;
            width: 0;
            height: 2px;
            bottom: -7px;
            left: 0;
            background: var(--primary);
            transition: 0.3s;
        }

        .nav-links a:hover {
            color: var(--primary);
        }

        .nav-links a:hover::after {
            width: 100%;
        }

        .nav-profile {
            display: flex;
            align-items: center;
            gap: 10px;
            color: white;
            font-size: 13px;
            font-weight: 600;
        }

        .nav-profile img {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid var(--primary);
        }

        /* =========================================================
           HERO
        ========================================================= */
        .hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            padding-top: 100px;
            position: relative;
        }

        .hero::before {
            content: "";
            position: absolute;
            width: 400px;
            height: 400px;
            background: rgba(0, 217, 255, 0.08);
            border-radius: 50%;
            filter: blur(100px);
            top: 10%;
            left: -150px;
        }

        .hero-content {
            display: grid;
            grid-template-columns: 1.2fr 0.8fr;
            gap: 60px;
            align-items: center;
        }

        .hero-text span {
            color: var(--primary);
            font-size: 17px;
            font-weight: 600;
        }

        .hero-text h1 {
            font-size: clamp(42px, 6vw, 72px);
            line-height: 1.1;
            margin: 15px 0;
            font-weight: 800;
        }

        .hero-text h1 .gradient-text {
            background: var(--gradient);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

        .hero-text h2 {
            font-size: 23px;
            color: var(--text-light);
            margin-bottom: 20px;
            font-weight: 500;
        }

        .hero-text p {
            color: var(--text-muted);
            max-width: 650px;
            margin-bottom: 30px;
        }

        .hero-buttons {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
            margin-bottom: 30px;
        }

        .btn {
            padding: 13px 25px;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 9px;
            transition: 0.3s;
        }

        .btn-primary {
            background: var(--gradient);
            color: white;
            box-shadow: 0 10px 25px rgba(0, 140, 255, 0.2);
        }

        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 35px rgba(0, 140, 255, 0.3);
        }

        .btn-outline {
            border: 1px solid rgba(0, 217, 255, 0.4);
            color: var(--primary);
            background: rgba(0, 217, 255, 0.04);
        }

        .btn-outline:hover {
            background: rgba(0, 217, 255, 0.1);
            transform: translateY(-3px);
        }

        .social-links {
            display: flex;
            gap: 12px;
        }

        .social-links a {
            width: 42px;
            height: 42px;
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-light);
            transition: 0.3s;
        }

        .social-links a:hover {
            color: var(--primary);
            border-color: var(--primary);
            transform: translateY(-4px);
        }

        .hero-image {
            position: relative;
            display: flex;
            justify-content: center;
        }

        .hero-image::before {
            content: "";
            position: absolute;
            width: 350px;
            height: 350px;
            border-radius: 50%;
            background: var(--gradient);
            opacity: 0.15;
            filter: blur(30px);
        }

        .hero-image img {
            width: 370px;
            height: 470px;
            object-fit: cover;
            border-radius: 30px;
            position: relative;
            z-index: 2;
            border: 1px solid rgba(0, 217, 255, 0.25);
            box-shadow: var(--shadow);
        }

        /* =========================================================
           SECTION TITLE
        ========================================================= */
        .section-title {
            text-align: center;
            margin-bottom: 60px;
        }

        .section-title span {
            color: var(--primary);
            font-size: 14px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        .section-title h2 {
            font-size: 40px;
            margin-top: 8px;
        }

        .section-title p {
            max-width: 650px;
            margin: 12px auto 0;
            color: var(--text-muted);
        }

        /* =========================================================
           ABOUT
        ========================================================= */
        .about {
            background: rgba(255,255,255,0.015);
        }

        .about-content {
            display: grid;
            grid-template-columns: 0.8fr 1.2fr;
            gap: 70px;
            align-items: center;
        }

        .about-image img {
            width: 100%;
            max-width: 420px;
            margin: auto;
            border-radius: 25px;
            border: 1px solid rgba(0, 217, 255, 0.2);
            box-shadow: var(--shadow);
        }

        .about-text h3 {
            font-size: 30px;
            margin-bottom: 15px;
        }

        .about-text h3 span {
            color: var(--primary);
        }

        .about-text p {
            color: var(--text-muted);
            margin-bottom: 18px;
        }

        .stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
            margin-top: 30px;
        }

        .stat {
            background: var(--card);
            border: 1px solid var(--card-border);
            border-radius: 15px;
            padding: 20px;
            text-align: center;
        }

        .stat h4 {
            color: var(--primary);
            font-size: 28px;
        }

        .stat p {
            margin: 0;
            font-size: 12px;
        }

        /* =========================================================
           SERVICES
        ========================================================= */
        .services-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
        }

        .service-card {
            padding: 35px 25px;
            background: var(--card);
            border: 1px solid var(--card-border);
            border-radius: 20px;
            transition: 0.35s;
        }

        .service-card:hover {
            transform: translateY(-8px);
            border-color: rgba(0, 217, 255, 0.4);
            box-shadow: var(--shadow);
        }

        .service-icon {
            width: 60px;
            height: 60px;
            border-radius: 15px;
            background: rgba(0, 217, 255, 0.1);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--primary);
            font-size: 25px;
            margin-bottom: 25px;
        }

        .service-card h3 {
            margin-bottom: 10px;
            font-size: 19px;
        }

        .service-card p {
            color: var(--text-muted);
            font-size: 13px;
        }

        /* =========================================================
           SKILLS
        ========================================================= */
        .skills {
            background: rgba(255,255,255,0.015);
        }

        .skills-container {
            max-width: 900px;
            margin: auto;
        }

        .skill {
            margin-bottom: 25px;
        }

        .skill-info {
            display: flex;
            justify-content: space-between;
            margin-bottom: 8px;
        }

        .skill-info span {
            font-size: 14px;
            color: var(--text-light);
        }

        .progress {
            height: 9px;
            background: rgba(255,255,255,0.08);
            border-radius: 10px;
            overflow: hidden;
        }

        .progress-bar {
            height: 100%;
            background: var(--gradient);
            border-radius: 10px;
        }

        /* =========================================================
           JOURNEY / EXPERIENCE
        ========================================================= */
        .timeline {
            max-width: 900px;
            margin: auto;
            position: relative;
        }

        .timeline::before {
            content: "";
            position: absolute;
            left: 50%;
            top: 0;
            bottom: 0;
            width: 2px;
            background: linear-gradient(
                to bottom,
                transparent,
                var(--primary),
                transparent
            );
            transform: translateX(-50%);
        }

        .timeline-item {
            width: 50%;
            padding: 15px 40px;
            position: relative;
        }

        .timeline-item:nth-child(odd) {
            left: 0;
            text-align: right;
        }

        .timeline-item:nth-child(even) {
            left: 50%;
        }

        .timeline-dot {
            position: absolute;
            width: 14px;
            height: 14px;
            border-radius: 50%;
            background: var(--primary);
            top: 28px;
            box-shadow: 0 0 0 6px rgba(0, 217, 255, 0.08);
        }

        .timeline-item:nth-child(odd) .timeline-dot {
            right: -7px;
        }

        .timeline-item:nth-child(even) .timeline-dot {
            left: -7px;
        }

        .timeline-card {
            padding: 25px;
            border-radius: 18px;
            background: var(--card);
            border: 1px solid var(--card-border);
            transition: 0.3s;
        }

        .timeline-card:hover {
            transform: translateY(-5px);
            border-color: rgba(0,217,255,0.35);
        }

        .timeline-card .date {
            color: var(--primary);
            font-size: 12px;
            font-weight: 600;
        }

        .timeline-card h3 {
            font-size: 17px;
            margin: 6px 0;
        }

        .timeline-card h4 {
            font-size: 13px;
            color: var(--text-light);
            font-weight: 500;
        }

        .timeline-card p {
            color: var(--text-muted);
            font-size: 12px;
            margin-top: 8px;
        }

        /* =========================================================
           PORTFOLIO
        ========================================================= */
        .portfolio {
            background: rgba(255,255,255,0.015);
        }

        .portfolio-filter {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 10px;
            margin-bottom: 40px;
        }

        .filter-btn {
            border: 1px solid rgba(255,255,255,0.1);
            background: transparent;
            color: var(--text-light);
            padding: 9px 20px;
            border-radius: 30px;
            font-family: inherit;
            cursor: pointer;
            font-size: 13px;
        }

        .filter-btn.active,
        .filter-btn:hover {
            background: var(--gradient);
            color: white;
            border-color: transparent;
        }

        .portfolio-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 25px;
        }

        .portfolio-card {
            background: var(--card);
            border: 1px solid var(--card-border);
            border-radius: 20px;
            overflow: hidden;
            transition: 0.35s;
        }

        .portfolio-card:hover {
            transform: translateY(-7px);
            box-shadow: var(--shadow);
        }

        .portfolio-image {
            height: 280px;
            overflow: hidden;
        }

        .portfolio-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: 0.5s;
        }

        .portfolio-card:hover .portfolio-image img {
            transform: scale(1.05);
        }

        .portfolio-info {
            padding: 25px;
        }

        .portfolio-info span {
            color: var(--primary);
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .portfolio-info h3 {
            margin-top: 5px;
            font-size: 20px;
        }

        /* =========================================================
           CONTACT
        ========================================================= */
        .contact-wrapper {
            display: grid;
            grid-template-columns: 0.8fr 1.2fr;
            gap: 50px;
            align-items: start;
        }

        .contact-info h3 {
            font-size: 30px;
            margin-bottom: 15px;
        }

        .contact-info > p {
            color: var(--text-muted);
            margin-bottom: 30px;
        }

        .contact-item {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 20px;
        }

        .contact-icon {
            width: 48px;
            height: 48px;
            min-width: 48px;
            border-radius: 13px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--primary);
            background: rgba(0,217,255,0.08);
        }

        .contact-item small {
            display: block;
            color: var(--text-muted);
            font-size: 11px;
        }

        .contact-item span {
            font-size: 14px;
        }

        .contact-form {
            background: var(--card);
            border: 1px solid var(--card-border);
            padding: 35px;
            border-radius: 20px;
        }

        .form-group {
            margin-bottom: 18px;
        }

        .form-group label {
            display: block;
            color: var(--text-light);
            font-size: 13px;
            margin-bottom: 7px;
        }

        .form-control {
            width: 100%;
            padding: 13px 15px;
            border-radius: 10px;
            border: 1px solid rgba(255,255,255,0.1);
            background: rgba(255,255,255,0.04);
            color: white;
            font-family: inherit;
            outline: none;
            transition: 0.3s;
        }

        .form-control:focus {
            border-color: var(--primary);
        }

        textarea.form-control {
            resize: vertical;
            min-height: 140px;
        }

        .contact-form button {
            border: none;
            cursor: pointer;
            width: 100%;
            justify-content: center;
        }

        /* =========================================================
           FOOTER
        ========================================================= */
        footer {
            padding: 30px 0;
            border-top: 1px solid rgba(255,255,255,0.06);
            text-align: center;
            color: var(--text-muted);
            font-size: 12px;
        }

        footer span {
            color: var(--primary);
        }

        /* =========================================================
           RESPONSIVE TABLET
        ========================================================= */
        @media (max-width: 1000px) {

            .nav-links {
                gap: 15px;
            }

            .nav-profile {
                display: none;
            }

            .hero-content {
                grid-template-columns: 1fr;
                text-align: center;
            }

            .hero-text p {
                margin-left: auto;
                margin-right: auto;
            }

            .hero-buttons,
            .social-links {
                justify-content: center;
            }

            .hero-image {
                order: -1;
            }

            .services-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .about-content {
                grid-template-columns: 1fr;
            }

            .about-image {
                order: -1;
            }

            .contact-wrapper {
                grid-template-columns: 1fr;
            }
        }

        /* =========================================================
           RESPONSIVE MOBILE
        ========================================================= */
        @media (max-width: 768px) {

            section {
                padding: 75px 0;
            }

            .container {
                width: 92%;
            }

            .navbar {
                height: 70px;
            }

            .logo {
                width: 42px;
                height: 42px;
            }

            .nav-links {
                display: none;
            }

            .hero {
                padding-top: 100px;
            }

            .hero-text h1 {
                font-size: 43px;
            }

            .hero-text h2 {
                font-size: 18px;
            }

            .hero-image img {
                width: 280px;
                height: 360px;
            }

            .section-title h2 {
                font-size: 32px;
            }

            .stats {
                grid-template-columns: 1fr;
            }

            .services-grid {
                grid-template-columns: 1fr;
            }

            .portfolio-grid {
                grid-template-columns: 1fr;
            }

            .timeline::before {
                left: 10px;
            }

            .timeline-item {
                width: 100%;
                left: 0 !important;
                text-align: left !important;
                padding-left: 40px;
                padding-right: 0;
            }

            .timeline-item:nth-child(odd) .timeline-dot,
            .timeline-item:nth-child(even) .timeline-dot {
                left: 3px;
                right: auto;
            }

            .contact-form {
                padding: 25px;
            }
        }

        @media (max-width: 480px) {

            .hero-text h1 {
                font-size: 37px;
            }

            .hero-buttons {
                flex-direction: column;
            }

            .btn {
                justify-content: center;
                width: 100%;
            }

            .portfolio-image {
                height: 220px;
            }

            .timeline-card {
                padding: 20px;
            }
        }
    </style>
</head>

